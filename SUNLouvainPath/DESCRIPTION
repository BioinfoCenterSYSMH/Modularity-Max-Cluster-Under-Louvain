Package: SUNLouvainPath
Type: Package
Title: MML Exact Enumeration of Deterministic Louvain Partitions on Seurat Graphs
Version: 0.3.1.9001
Authors@R: c(
    person("Junbo", "Wang", role = c("aut", "cre"),
           email = "99457639+SYSUWangJunbo@users.noreply.github.com",
           comment = "王俊博"),
